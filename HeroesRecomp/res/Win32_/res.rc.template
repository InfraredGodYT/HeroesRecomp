#include <windows.h>

#define HEROES_RECOMP_VERSION_BIN @WIN32_VERSION_BINARY@
#define HEROES_RECOMP_VERSION_STR "@WIN32_VERSION_STRING@"

#ifdef _DEBUG
#define HEROES_RECOMP_FILE_FLAGS VS_FF_DEBUG
#else
#define HEROES_RECOMP_FILE_FLAGS 0
#endif

IDI_ICON1 ICON "@WIN32_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    HEROES_RECOMP_VERSION_BIN
    PRODUCTVERSION HEROES_RECOMP_VERSION_BIN
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      HEROES_RECOMP_FILE_FLAGS
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904B0" // English (UK), Unicode
        BEGIN
            VALUE "ProductName",      "Heroes Recompiled"
            VALUE "FileDescription",  "Heroes Recompiled"
            VALUE "CompanyName",      "InfraredGodYT"
            VALUE "FileVersion",      HEROES_RECOMP_VERSION_STR
            VALUE "ProductVersion",   HEROES_RECOMP_VERSION_STR
            VALUE "InternalName",     "HeroesRecomp"
            VALUE "OriginalFilename", "shadow.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 0x04B0
    END
END
