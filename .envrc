# HeroesRecomp direnv config.
# Recommended: nix-direnv (https://github.com/nix-community/nix-direnv) for caching.

_sr_warn() {
  printf '\033[1;33m[heroesrecomp]\033[0m %s\n' "$1" >&2
}

# Game executable: required to build.
if [ ! -f HeroesRecompLib/private/default.xbe ]; then
  _sr_warn "HeroesRecompLib/private/default.xbe is MISSING."
  _sr_warn "  Copy default.xbe from your legally owned copy of the game (Xbox version)."
fi
watch_file HeroesRecompLib/private/default.xbe

use flake .
