# Generate before collecting sources.
# Amount of files generated by the CLI isn't fixed. e.g. Changes in config
# could cause more/less functions to be detected.
set(recompiler_config "${CMAKE_CURRENT_SOURCE_DIR}/config/recompConfig.toml")
set(recompiler_input "${CMAKE_CURRENT_SOURCE_DIR}/private/default.xbe")
if(NOT EXISTS "${recompiler_input}")
    message(FATAL_ERROR "Missing ${recompiler_input}. Copy default.xbe from your game before configuring.")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${recompiler_config}" "${recompiler_input}"
)

# Pick the recompiler:
# - built from the submodule
# - a release
# - or a given binary
include("${CMAKE_CURRENT_LIST_DIR}/recompile/select.cmake")
xboxrecomp2_select(recompiler_executable)

# Use separate output so stale units (when we get less files than last time)
# wouldn't survive.
set(generation_dir "${CMAKE_CURRENT_BINARY_DIR}/recompile")
file(REMOVE_RECURSE "${generation_dir}")
file(MAKE_DIRECTORY "${generation_dir}")
file(READ "${recompiler_config}" config_text)
file(RELATIVE_PATH relative_input "${generation_dir}" "${recompiler_input}")
string(REGEX REPLACE "file_path = [^\n]*" "file_path = '${relative_input}'" config_text "${config_text}")
string(REGEX REPLACE "out_directory_path = [^\n]*" "out_directory_path = '${generation_dir}/x86'" config_text "${config_text}")
file(WRITE "${generation_dir}/config.toml" "${config_text}")
execute_process(
    COMMAND "${recompiler_executable}" recompile "${generation_dir}/config.toml"
    COMMAND_ERROR_IS_FATAL ANY
)

file(GLOB generated_files "${generation_dir}/x86/x86_*")
if(NOT EXISTS "${generation_dir}/x86/x86_recomp.0.cpp")
    message(FATAL_ERROR "XboxRecomp2 produced no translation units. Check its diagnostics above.")
endif()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/x86")
file(GLOB old_files "${CMAKE_CURRENT_BINARY_DIR}/x86/x86_*")
foreach(old_file IN LISTS old_files)
    get_filename_component(name "${old_file}" NAME)
    if(NOT EXISTS "${generation_dir}/x86/${name}")
        file(REMOVE "${old_file}")
    endif()
endforeach()
foreach(generated_file IN LISTS generated_files)
    get_filename_component(name "${generated_file}" NAME)
    configure_file("${generated_file}" "${CMAKE_CURRENT_BINARY_DIR}/x86/${name}" COPYONLY)
endforeach()

file(GLOB HEROES_RECOMP_X86_RECOMPILED_SOURCES CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_BINARY_DIR}/x86/x86_*.h"
    "${CMAKE_CURRENT_BINARY_DIR}/x86/x86_*.cpp"
)
